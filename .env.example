# =====================================================================
# Research Automation Engine - web app settings
# =====================================================================
# Running on your own computer: copy this file to ".env.local" and fill it in.
# Hosting on Vercel: add each of these in Project -> Settings -> Environment Variables.
# The setup guide in README.md explains where every value comes from.
# Never commit your real .env.local file - it is already in .gitignore.

# ---------------------------------------------------------------------
# Supabase (REQUIRED) - Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-public-key
# Secret! Server-side only. Never put this in front-end code or share it.
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key

# ---------------------------------------------------------------------
# Redis queue (REQUIRED) - Upstash dashboard -> your database
# ---------------------------------------------------------------------
# The "rediss://..." connection string (TCP). Must be the SAME value in the worker.
REDIS_URL=rediss://default:YOUR-PASSWORD@YOUR-ENDPOINT.upstash.io:6379
# The REST URL + token (used for rate limiting).
UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=paste-the-rest-token
# Leave this as true - research runs go through the queue + worker.
USE_QUEUE_SYSTEM=true

# ---------------------------------------------------------------------
# Encryption (REQUIRED) - protects the API keys users save in the app
# ---------------------------------------------------------------------
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the SAME two values in the worker. If you change them later, every
# saved API key becomes unreadable and users have to re-enter their keys.
ENCRYPTION_SECRET_KEY=generate-a-64-character-random-hex-string
ENCRYPTION_SALT=generate-a-different-64-character-random-hex-string

# ---------------------------------------------------------------------
# App address (REQUIRED)
# ---------------------------------------------------------------------
# On your own computer: http://localhost:3000
# On Vercel: your site address, e.g. https://my-research-engine.vercel.app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the worker uses to tell the app "this job finished, start the
# next queued one". Generate like the encryption values. SAME value in the worker.
WORKER_CALLBACK_SECRET=generate-a-random-hex-string

# ---------------------------------------------------------------------
# Email via Resend (OPTIONAL)
# ---------------------------------------------------------------------
# Login links are sent by Supabase, not Resend. Resend is only used for
# "your research is done" emails and when an admin invites someone.
# RESEND_API_KEY=re_xxxxxxxxx
# Without your own domain verified in Resend, keep the default sender below -
# it can only deliver to the email address on your Resend account.
# EMAIL_FROM=Research Automation Engine <onboarding@resend.dev>

# ---------------------------------------------------------------------
# Claude models (OPTIONAL) - only change these when Anthropic retires a model
# ---------------------------------------------------------------------
# CLAUDE_MODEL=claude-opus-4-6
# CLAUDE_KEY_CHECK_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------
# Automatic sign-ups from a payment webhook (OPTIONAL, advanced)
# ---------------------------------------------------------------------
# POST /api/provision with header "Authorization: Bearer <this secret>" and
# a JSON body like {"email":"buyer@example.com"} creates an account.
# Leave unset if you add people yourself.
# HIGHLEVEL_WEBHOOK_SECRET=generate-a-random-hex-string
