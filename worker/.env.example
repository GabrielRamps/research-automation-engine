# =====================================================================
# Research Automation Engine - background worker settings
# =====================================================================
# Running on your own computer: copy this file to "worker/.env" and fill it in.
# Hosting on Railway: add each of these in your service -> Variables.
# Values marked SAME must match the web app exactly.

# Supabase (REQUIRED) - SAME as the app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key

# Upstash Redis TCP connection string (REQUIRED) - SAME as the app
REDIS_URL=rediss://default:YOUR-PASSWORD@YOUR-ENDPOINT.upstash.io:6379

# Encryption (REQUIRED) - SAME two values as the app
ENCRYPTION_SECRET_KEY=same-value-as-the-app
ENCRYPTION_SALT=same-value-as-the-app

# Where the web app lives (REQUIRED) - used for links in emails and to
# tell the app when a job is finished.
# On your own computer: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WORKER_CALLBACK_SECRET=same-value-as-the-app

# Logging: debug | info | warn | error
LOG_LEVEL=warn

# Email when research finishes (OPTIONAL)
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Research Automation Engine <onboarding@resend.dev>

# Claude models (OPTIONAL) - only change these when Anthropic retires a model
# CLAUDE_MODEL=claude-opus-4-6
# CLAUDE_FAST_MODEL=claude-sonnet-4-6

# DataForSEO async callbacks (OPTIONAL, advanced - leave unset)
# DATAFORSEO_WEBHOOK_BASE_URL=
# DATAFORSEO_WEBHOOK_SECRET=
